# Enkihost Sinatra Environment Configuration Template
RACK_ENV=development
APP_ENV=development
PORT=4567

# Security Keys (Generate 32-byte hex or random string)
SECRET_KEY_BASE=development_secret_key_base_32_bytes_long_!
JWT_SECRET_KEY=development_jwt_secret_key_32_bytes_long_!

# URLs
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 Credentials
# Configure authorized redirect URIs in Google Cloud Console:
# - http://localhost:3000/auth/callback
# - http://localhost:4567/api/v1/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Database & Redis
DATABASE_URL=postgres://postgres:password@localhost:5432/enkihost_api_development
REDIS_URL=redis://localhost:6379/1

# ActiveRecord Encryption Keys (32 bytes)
AR_PRIMARY_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c
AR_DETERMINISTIC_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c
AR_SALT=salt_enkihost_dev_2026_secure_!!
